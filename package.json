  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "db:bootstrap": "node ./scripts/bootstrap-core-schema.mjs",
    "db:import": "node ./scripts/import-kickstarter-snapshot.mjs",
    "db:import:ttrpg": "node ./scripts/import-kickstarter-snapshot.mjs --file ../DataSet/Kickstarter_2026-08-12T08_12_02_805Z_deduped_ttrpg_subset.json --source-name \"Web Robots Kickstarter Dataset\" --snapshot-version 2026-08-12 --subset-key ttrpg_poc --subset-version 2026-08-16-initial --subset-status include_medium --subset-confidence include_medium --subset-reason \"Initial broad TTRPG/D&D subset import for Backer Sonar POC\"",
    "db:prune:ttrpg": "node ./scripts/prune-to-subset.mjs --subset-key ttrpg_poc",
    "db:status": "node ./scripts/db-status.mjs",
    "db:account:role": "node ./scripts/set-account-role.mjs",
    "db:seed:taxonomy": "node ./scripts/seed-ttrpg-taxonomy.mjs",
    "db:classify:ttrpg": "node ./scripts/classify-ttrpg-campaigns.mjs --subset-key ttrpg_poc",
    "db:normalize:currency": "node ./scripts/normalize-campaign-currency.mjs",
    "db:normalize:currency:ttrpg": "node ./scripts/normalize-campaign-currency.mjs --subset-key ttrpg_poc",
    "db:validate:currency": "node ./scripts/validate-currency-normalization.mjs",
    "db:refresh:analysis": "node ./scripts/refresh-category-analysis.mjs --subset-key ttrpg_poc",
    "db:validate:analysis": "node ./scripts/validate-category-analysis.mjs",
    "test:research": "node --experimental-strip-types --test ./tests/research-query.test.ts ./tests/research-benchmarks.test.ts ./tests/ttrpg-taxonomy.test.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@types/ms": "^0.7.32",
    "@types/node": "20.8.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.16",
    "eslint": "^8",
    "eslint-config-next": "^15.1.6",
    "ms": "^2.1.3",
    "next": "^16.0.10",
    "postcss": "8.4.31",
    "postgres": "^3.4.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "resend": "^6.20.0",
    "tailwindcss": "3.3.3",
    "typescript": "^5"
  }
}
